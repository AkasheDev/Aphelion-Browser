<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Colour tokens. Brand values come from shared/design/colors.json; the surface
    ramp is derived from the logo's violet-to-cyan gradient so the chrome reads as
    one family rather than neutral grey with a coloured accent bolted on.

    Every token is defined in both variants. Nothing may be defined in only one.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BrandPrimary">#5A4FCF</Color>
      <Color x:Key="BrandAccent">#0E9AA7</Color>

      <!-- Surface ramp, lightest to deepest -->
      <Color x:Key="SurfaceBase">#FFFFFF</Color>
      <Color x:Key="SurfaceRaised">#F5F5FA</Color>
      <Color x:Key="SurfaceSunken">#E9E9F2</Color>
      <Color x:Key="SurfaceHover">#DEDEEB</Color>

      <Color x:Key="Foreground">#1A1A24</Color>
      <Color x:Key="ForegroundMuted">#5C5C70</Color>
      <Color x:Key="ForegroundOnAccent">#FFFFFF</Color>

      <Color x:Key="Divider">#D8D8E4</Color>
      <Color x:Key="FocusRing">#5A4FCF</Color>
      <Color x:Key="CloseHover">#D93544</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BrandPrimary">#8C83FF</Color>
      <Color x:Key="BrandAccent">#3FD8E4</Color>

      <Color x:Key="SurfaceBase">#14141C</Color>
      <Color x:Key="SurfaceRaised">#1B1B26</Color>
      <Color x:Key="SurfaceSunken">#0E0E15</Color>
      <Color x:Key="SurfaceHover">#262634</Color>

      <Color x:Key="Foreground">#EDEDF5</Color>
      <Color x:Key="ForegroundMuted">#9A9AB0</Color>
      <Color x:Key="ForegroundOnAccent">#12121A</Color>

      <Color x:Key="Divider">#2A2A38</Color>
      <Color x:Key="FocusRing">#8C83FF</Color>
      <Color x:Key="CloseHover">#E04452</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{DynamicResource BrandPrimary}" />
  <SolidColorBrush x:Key="BrandAccentBrush" Color="{DynamicResource BrandAccent}" />

  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{DynamicResource SurfaceBase}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaised}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunken}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHover}" />

  <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource Foreground}" />
  <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{DynamicResource ForegroundMuted}" />
  <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="{DynamicResource ForegroundOnAccent}" />

  <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource Divider}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRing}" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="{DynamicResource CloseHover}" />

  <!-- Tab group markers. A closed palette mapped from the domain's GroupColor,
       chosen to stay legible against both the light and dark chrome. -->
  <SolidColorBrush x:Key="GroupVioletBrush" Color="#8C83FF" />
  <SolidColorBrush x:Key="GroupCyanBrush" Color="#3FD8E4" />
  <SolidColorBrush x:Key="GroupEmeraldBrush" Color="#3FD9A0" />
  <SolidColorBrush x:Key="GroupAmberBrush" Color="#F0B849" />
  <SolidColorBrush x:Key="GroupRoseBrush" Color="#F2688A" />
  <SolidColorBrush x:Key="GroupSlateBrush" Color="#8A90A8" />

  <!-- Geometry -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">18</CornerRadius>

</ResourceDictionary>
