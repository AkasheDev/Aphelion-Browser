<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Colour tokens. Brand values come from shared/design/colors.json; the surface
    ramp is derived from the logo's violet-to-cyan gradient so the chrome reads as
    one family rather than neutral grey with a coloured accent bolted on.

    Every token is defined in both variants. Nothing may be defined in only one.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="BrandPrimary">#5A4FCF</Color>
      <Color x:Key="BrandAccent">#0E9AA7</Color>

      <!-- Surface ramp, lightest to deepest -->
      <Color x:Key="SurfaceBase">#FFFFFF</Color>
      <!-- The same surface at zero alpha, for gradients that fade into the bar.
           A gradient stop cannot carry its own opacity, so the transparent end
           has to be stated per theme rather than derived. -->
      <Color x:Key="SurfaceBaseFaded">#00FFFFFF</Color>
      <Color x:Key="SurfaceRaised">#F5F5FA</Color>
      <Color x:Key="SurfaceSunken">#E9E9F2</Color>
      <Color x:Key="SurfaceHover">#DEDEEB</Color>

      <Color x:Key="Foreground">#1A1A24</Color>
      <Color x:Key="ForegroundMuted">#5C5C70</Color>
      <Color x:Key="ForegroundOnAccent">#FFFFFF</Color>

      <Color x:Key="Divider">#D8D8E4</Color>
      <Color x:Key="FocusRing">#5A4FCF</Color>
      <Color x:Key="CloseHover">#D93544</Color>

      <!-- New Tab follows the shell theme like everything else; these semantic
           tokens keep every view free of literals. The starfield and glass
           surfaces read as a bright sky rather than deep space here — the
           control drawing them (NewTabStarfield) takes its colours entirely
           from these tokens, so nothing in that code is dark-specific. -->
      <Color x:Key="NewTabBackdrop">#EEF0FA</Color>
      <Color x:Key="NewTabGlass">#B8FFFFFF</Color>
      <Color x:Key="NewTabGlassHover">#D3FFFFFF</Color>
      <Color x:Key="NewTabGlassBorder">#381A1A38</Color>
      <Color x:Key="NewTabForeground">#1A1A24</Color>
      <Color x:Key="NewTabMuted">#5C5C7A</Color>
      <Color x:Key="NewTabViolet">#5A4FCF</Color>
      <Color x:Key="NewTabCyan">#0E9AA7</Color>
      <Color x:Key="NewTabWarm">#E29A3C</Color>
      <Color x:Key="NewTabPositive">#2FA679</Color>
      <Color x:Key="NewTabSceneScrim">#06000000</Color>
      <Color x:Key="NewTabVignetteClear">#00000000</Color>
      <Color x:Key="NewTabVignetteSoft">#05000000</Color>
      <Color x:Key="NewTabVignetteEdge">#22000000</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BrandPrimary">#8C83FF</Color>
      <Color x:Key="BrandAccent">#3FD8E4</Color>

      <Color x:Key="SurfaceBase">#14141C</Color>
      <Color x:Key="SurfaceBaseFaded">#0014141C</Color>
      <Color x:Key="SurfaceRaised">#1B1B26</Color>
      <Color x:Key="SurfaceSunken">#0E0E15</Color>
      <Color x:Key="SurfaceHover">#262634</Color>

      <Color x:Key="Foreground">#EDEDF5</Color>
      <Color x:Key="ForegroundMuted">#9A9AB0</Color>
      <Color x:Key="ForegroundOnAccent">#12121A</Color>

      <Color x:Key="Divider">#2A2A38</Color>
      <Color x:Key="FocusRing">#8C83FF</Color>
      <Color x:Key="CloseHover">#E04452</Color>

      <Color x:Key="NewTabBackdrop">#050611</Color>
      <Color x:Key="NewTabGlass">#B8121424</Color>
      <Color x:Key="NewTabGlassHover">#D31E2238</Color>
      <Color x:Key="NewTabGlassBorder">#32FFFFFF</Color>
      <Color x:Key="NewTabForeground">#F7F8FF</Color>
      <Color x:Key="NewTabMuted">#A8B2CC</Color>
      <Color x:Key="NewTabViolet">#8C78FF</Color>
      <Color x:Key="NewTabCyan">#3FD8E4</Color>
      <Color x:Key="NewTabWarm">#FFC978</Color>
      <Color x:Key="NewTabPositive">#75E6B5</Color>
      <Color x:Key="NewTabSceneScrim">#12000000</Color>
      <Color x:Key="NewTabVignetteClear">#00000000</Color>
      <Color x:Key="NewTabVignetteSoft">#09000000</Color>
      <Color x:Key="NewTabVignetteEdge">#66000000</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{DynamicResource BrandPrimary}" />
  <SolidColorBrush x:Key="BrandAccentBrush" Color="{DynamicResource BrandAccent}" />

  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{DynamicResource SurfaceBase}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{DynamicResource SurfaceRaised}" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunken}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHover}" />

  <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource Foreground}" />
  <SolidColorBrush x:Key="ForegroundMutedBrush" Color="{DynamicResource ForegroundMuted}" />
  <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="{DynamicResource ForegroundOnAccent}" />

  <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource Divider}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRing}" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="{DynamicResource CloseHover}" />

  <SolidColorBrush x:Key="NewTabBackdropBrush" Color="{DynamicResource NewTabBackdrop}" />
  <SolidColorBrush x:Key="NewTabGlassBrush" Color="{DynamicResource NewTabGlass}" />
  <SolidColorBrush x:Key="NewTabGlassHoverBrush" Color="{DynamicResource NewTabGlassHover}" />
  <SolidColorBrush x:Key="NewTabGlassBorderBrush" Color="{DynamicResource NewTabGlassBorder}" />
  <SolidColorBrush x:Key="NewTabForegroundBrush" Color="{DynamicResource NewTabForeground}" />
  <SolidColorBrush x:Key="NewTabMutedBrush" Color="{DynamicResource NewTabMuted}" />
  <SolidColorBrush x:Key="NewTabVioletBrush" Color="{DynamicResource NewTabViolet}" />
  <SolidColorBrush x:Key="NewTabCyanBrush" Color="{DynamicResource NewTabCyan}" />
  <SolidColorBrush x:Key="NewTabWarmBrush" Color="{DynamicResource NewTabWarm}" />
  <SolidColorBrush x:Key="NewTabPositiveBrush" Color="{DynamicResource NewTabPositive}" />

  <!-- Tab group markers. A closed palette mapped from the domain's GroupColor,
       chosen to stay legible against both the light and dark chrome. -->
  <SolidColorBrush x:Key="GroupVioletBrush" Color="#8C83FF" />
  <SolidColorBrush x:Key="GroupCyanBrush" Color="#3FD8E4" />
  <SolidColorBrush x:Key="GroupEmeraldBrush" Color="#3FD9A0" />
  <SolidColorBrush x:Key="GroupAmberBrush" Color="#F0B849" />
  <SolidColorBrush x:Key="GroupRoseBrush" Color="#F2688A" />
  <SolidColorBrush x:Key="GroupSlateBrush" Color="#8A90A8" />

  <!-- Typography. Inter ships with the application via Avalonia.Fonts.Inter, so
       the interface renders identically on all three platforms. -->
  <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

  <!-- Geometry -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">18</CornerRadius>

</ResourceDictionary>
