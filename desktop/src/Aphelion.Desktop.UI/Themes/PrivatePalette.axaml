<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Private mode's palette, merged into a private window's own resources so it
    overrides the shared one for that window alone. Ordinary windows never see
    it and no theme switching is involved.

    Neutral throughout: shades of black, with no hue left in them. The brand
    violet is gone from this window entirely rather than darkened, so nothing
    here reads as the ordinary theme turned down.

    The brushes are restated with literal colours rather than left to follow the
    Color keys. A brush declared in the application's dictionary resolves its
    colour from where the brush itself lives, not from the window using it, so
    overriding only the colours here would leave every brush unchanged.

    Group colours are deliberately absent: a group is identified by its colour,
    and has to stay recognisably itself in a private window. They are literal in
    the shared palette and stay exactly as they are.
  -->

  <Color x:Key="BrandPrimary">#2E2E2E</Color>
  <Color x:Key="BrandAccent">#292929</Color>

  <Color x:Key="SurfaceBase">#070707</Color>
  <Color x:Key="SurfaceBaseFaded">#00070707</Color>
  <Color x:Key="SurfaceRaised">#0D0D0D</Color>
  <Color x:Key="SurfaceSunken">#030303</Color>
  <Color x:Key="SurfaceHover">#1A1A1A</Color>

  <Color x:Key="Foreground">#E2E2E2</Color>
  <Color x:Key="ForegroundMuted">#7A7A7A</Color>
  <Color x:Key="ForegroundOnAccent">#EDEDED</Color>

  <Color x:Key="Divider">#1C1C1C</Color>
  <Color x:Key="FocusRing">#4D4D4D</Color>
  <!-- The one place a hue survives: closing is destructive and the warning is
       worth more than the uniformity. Held well down all the same. -->
  <Color x:Key="CloseHover">#6E2E2E</Color>

  <Color x:Key="NewTabBackdrop">#050505</Color>
  <Color x:Key="NewTabGlass">#B80B0B0B</Color>
  <Color x:Key="NewTabGlassHover">#D3161616</Color>
  <Color x:Key="NewTabGlassBorder">#1FFFFFFF</Color>
  <Color x:Key="NewTabForeground">#E4E4E4</Color>
  <Color x:Key="NewTabMuted">#808080</Color>
  <Color x:Key="NewTabViolet">#333333</Color>
  <Color x:Key="NewTabCyan">#2A2A2A</Color>
  <Color x:Key="NewTabWarm">#3A3A3A</Color>
  <Color x:Key="NewTabPositive">#2E2E2E</Color>

  <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2E2E2E" />
  <SolidColorBrush x:Key="BrandAccentBrush" Color="#292929" />

  <SolidColorBrush x:Key="SurfaceBaseBrush" Color="#070707" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#0D0D0D" />
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#030303" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1A1A1A" />

  <SolidColorBrush x:Key="ForegroundBrush" Color="#E2E2E2" />
  <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#7A7A7A" />
  <SolidColorBrush x:Key="ForegroundOnAccentBrush" Color="#EDEDED" />

  <SolidColorBrush x:Key="DividerBrush" Color="#1C1C1C" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="#4D4D4D" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="#6E2E2E" />

  <SolidColorBrush x:Key="NewTabBackdropBrush" Color="#050505" />
  <SolidColorBrush x:Key="NewTabGlassBrush" Color="#B80B0B0B" />
  <SolidColorBrush x:Key="NewTabGlassHoverBrush" Color="#D3161616" />
  <SolidColorBrush x:Key="NewTabGlassBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="NewTabForegroundBrush" Color="#E4E4E4" />
  <SolidColorBrush x:Key="NewTabMutedBrush" Color="#808080" />
  <SolidColorBrush x:Key="NewTabVioletBrush" Color="#333333" />
  <SolidColorBrush x:Key="NewTabCyanBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="NewTabWarmBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="NewTabPositiveBrush" Color="#2E2E2E" />

</ResourceDictionary>
