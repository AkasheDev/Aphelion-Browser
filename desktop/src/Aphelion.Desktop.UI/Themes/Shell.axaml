<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aphelion.Desktop.UI.Controls">

  <!-- ===== Typography =====

       Inter throughout, bundled with the application rather than relying on a
       system font, so the interface looks the same on Windows, macOS and Linux.
       Google Sans, which inspired the look, is proprietary and cannot ship in an
       AGPL project; Inter is the closest open-licensed equivalent. -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <!-- Scrolling tab title.

       No TextTrimming: an ellipsis needs about as much room as a character, so
       in a narrow tab it is all that fits and the name reads as "…". The control
       clips instead, which keeps the opening letters visible however tight the
       tab gets. -->
  <Style Selector="controls|MarqueeTextBlock">
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock Name="PART_Text"
                   Text="{TemplateBinding Text}"
                   FontSize="{TemplateBinding FontSize}"
                   FontFamily="{TemplateBinding FontFamily}"
                   Foreground="{TemplateBinding Foreground}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!--
    Shell chrome styling.

    All glyphs are vector Path data rather than icon-font characters: the icon
    fonts present on Windows do not exist on macOS or Linux, where they would
    render as replacement boxes.
  -->

  <!-- ===== Title bar ===== -->

  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- ===== Tabs ===== -->

  <!-- Slide animation for reordering lives on the item containers and is driven
       by TabStripDragHandler; only the hover colour animates from here. -->
  <!-- Width comes from TabStripPanel, which shares the strip evenly between
       tabs; a MinWidth or MaxWidth here would fight that. -->
  <Style Selector="Border.tab">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The same pose is used at both ends: a new tab starts here and eases to
       normal; a closing tab eases here before the collection removes it. -->
  <Style Selector="Border.tab.exiting">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 3px) scale(0.96)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Group chips -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.chip:pointerover Border.chip-pill">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.chip-pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- The ring a bar chip wears while its group is open in the tab strip. It
       sits outside the pill with a gap of bar background between, since a
       border in the group's own colour would vanish against the pill it
       outlines. The ring is always present and only its colour changes, so a
       dormant chip keeps the exact footprint of a live one. Never hide it with
       Opacity: that applies to the whole subtree and would take the pill with
       it, leaving a blank gap on the bar. -->
  <Style Selector="Border.chip-live-ring">
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBlock.chip-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundOnAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.012)" />
  </Style>

  <!-- Keep the active surface fill and add a complete outline; a bottom-only
       accent looked unrelated to the rounded title-bar language. -->
  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.tab controls|MarqueeTextBlock.tab-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Border.tab.active controls|MarqueeTextBlock.tab-title">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- Favicon, and the placeholder shown before one arrives -->
  <Style Selector="Image.favicon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Separates the two halves of a split pair in the strip -->
  <Style Selector="Border.split-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- A split pair carries a hairline outline so it is recognisable as a pair
       even at the narrowest width, where the second favicon is all that shows. -->
  <Style Selector="Border.tab.split">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.tab.active.split">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <!-- The partner's title, styled like the primary one -->
  <Style Selector="Border.tab controls|MarqueeTextBlock.tab-title-partner">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Border.tab.active controls|MarqueeTextBlock.tab-title-partner">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Path.favicon-fallback">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Group marker: a rounded bar in the group's colour -->
  <Style Selector="Border.group-marker">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Icon buttons: tab close, chrome actions ===== -->

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!-- An icon sitting inside another control draws no hover of its own: the
       address box is already a filled pill, and a second filled shape on top of
       it reads as a box stuck to the box rather than as a button waking up. Used
       by the bookmark star, which rides inside the address box. -->
  <Style Selector="Button.icon.inset:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon.inset:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon:pointerover Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.icon:disabled Path.glyph">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- ===== Caption buttons ===== -->

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
  </Style>

  <Style Selector="Path.caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption.close:pointerover Path.caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundOnAccentBrush}" />
  </Style>

  <!-- ===== Address bar ===== -->

  <Style Selector="TextBox.address">
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBox.address:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="TextBox.address:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- ===== New tab page ===== -->

  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.newtab-muted">
    <Setter Property="Foreground" Value="{DynamicResource NewTabMutedBrush}" />
  </Style>

  <Style Selector="WrapPanel.newtab-greeting">
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <!-- The logo remains just the logo; a blurred duplicate behind it follows its
       own silhouette and gives it a restrained presence against the star field. -->
  <Style Selector="Grid.newtab-logo-mark">
    <Setter Property="Width" Value="88" />
    <Setter Property="Height" Value="88" />
  </Style>

  <Style Selector="Image.newtab-logo-glow">
    <Setter Property="Width" Value="88" />
    <Setter Property="Height" Value="88" />
    <Setter Property="Opacity" Value="0.48" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Effect"><BlurEffect Radius="13" /></Setter>
  </Style>

  <Style Selector="Image.newtab-logo-image">
    <Setter Property="Width" Value="76" />
    <Setter Property="Height" Value="76" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Private mode's own mark: the same image, muted rather than swapped for a
       different glyph. Avalonia's public Effect set has no saturation filter
       (only blur and drop shadow), so the grey read comes from opacity alone —
       low enough that the brand colour recedes, high enough that it is still
       recognisably the logo rather than a silhouette. -->
  <!-- Held back rather than drawn at full strength: the mark is the brightest
       thing on an otherwise unlit page, and private mode should stay quiet. -->
  <Style Selector="Image.newtab-logo-image.private">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="TextBlock.newtab-greeting-headline">
    <Setter Property="FontSize" Value="31" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.45" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.newtab-greeting-prompt">
    <Setter Property="FontSize" Value="31" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="LetterSpacing" Value="-0.55" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.newtab-glass">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.newtab-search">
    <Setter Property="Height" Value="58" />
    <Setter Property="CornerRadius" Value="29" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource NewTabGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The bar had no hover of its own, so pointing at it did nothing while the
       TextBox inside it lit up with the stock theme's own hover — brighter than
       anything around it, and untouched by the palette. Both are answered here:
       the bar lifts, and the box is held transparent in every state so only the
       bar responds. -->
  <Style Selector="Border.newtab-search:pointerover">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
  </Style>

  <Style Selector="Border.newtab-search:focus-within">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabVioletBrush}" />
  </Style>

  <Style Selector="Button.newtab-engine-trigger">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-engine-trigger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.newtab-engine-picker">
    <Setter Property="Width" Value="190" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.newtab-engine-option">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Button.newtab-engine-option /template/ ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.newtab-engine-option:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Border.newtab-engine-picker-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Not a card. The suggestions used to sit in a bordered, shadowed panel hung
       under the search box, which read as a panel inside a panel: two stacked
       surfaces competing for the same attention. What is left is a bare column
       of rows directly on the starfield — no ground, no border, no shadow. The
       only thing that reads as drawn is the row under the pointer, which is why
       this can be fully transparent now that it is part of the page rather than
       a Popup with its own opaque window behind it. -->
  <Style Selector="ItemsControl.newtab-suggestions">
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style Selector="Button.newtab-suggestion">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <!-- A full pill on hover, echoing the shape of the search box above it, so the
       hovered row looks like the query it would become rather than a menu item. -->
  <Style Selector="Button.newtab-suggestion:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
    <Setter Property="CornerRadius" Value="23" />
  </Style>

  <!-- Bare glyph, no badge behind it: the badge was another nested surface, and
       at this size the magnifier alone carries the meaning. -->
  <Style Selector="Path.newtab-suggestion-glyph">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.newtab-suggestion:pointerover Path.newtab-suggestion-glyph">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.newtab-suggestion TextBlock.newtab-suggestion-text">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabMutedBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The text is the element that brightens; weight stays put so rows do not
       shift sideways as the pointer moves down the list. -->
  <Style Selector="Button.newtab-suggestion:pointerover TextBlock.newtab-suggestion-text">
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
  </Style>

  <!-- Only visible on hover: a hint that Enter/click sends this one, matching
       the arrow on the search button itself. -->
  <Style Selector="Button.newtab-suggestion Path.newtab-suggestion-go">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.newtab-suggestion:pointerover Path.newtab-suggestion-go">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="TextBox.newtab-search-box">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.newtab-search-box /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- The stock TextBox theme repaints this on hover and on focus, which showed
       through the bar as a lighter rectangle inside a rounded pill. -->
  <Style Selector="TextBox.newtab-search-box:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.newtab-search-box:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-search-submit">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="21" />
    <Setter Property="Background" Value="{DynamicResource NewTabVioletBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-search-submit:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
  </Style>

  <Style Selector="Button.newtab-weather">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-weather:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
  </Style>

  <Style Selector="Button.newtab-weather-off">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-weather-off:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
  </Style>

  <Style Selector="Button.newtab-weather-off TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.newtab-weather-location">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.15" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.newtab-weather-condition">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.newtab-weather-temperature">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.newtab-shortcut">
    <Setter Property="Width" Value="108" />
    <Setter Property="Height" Value="92" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.newtab-shortcut /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.newtab-shortcut:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.newtab-shortcut-tile">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource NewTabGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabGlassBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.newtab-shortcut:pointerover Border.newtab-shortcut-tile">
    <Setter Property="Background" Value="{DynamicResource NewTabGlassHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabVioletBrush}" />
  </Style>

  <Style Selector="Border.newtab-shortcut-add">
    <Setter Property="BorderBrush" Value="{DynamicResource NewTabMutedBrush}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="TextBlock.newtab-shortcut-label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.05" />
    <Setter Property="Foreground" Value="{DynamicResource NewTabForegroundBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== Menus =====

       One global look for every context menu in the application. Menus defined
       anywhere pick this up automatically; no menu carries local styling. -->

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- An editor hosted inside a menu item, e.g. renaming a group -->
  <Style Selector="TextBox.menu-editor">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
  </Style>

  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- ===== Split panes =====

       Only a split shows the focus border; a single pane has nothing to
       distinguish itself from. -->

  <Style Selector="Border.pane">
    <Setter Property="BorderThickness" Value="0" />
    <!-- The web view is a native control and will happily paint past its
         bounds; without clipping the right pane spills over the window edge. -->
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- The accent sits under the pane, not over it: above, it butted into the
       toolbar and read as part of the chrome rather than as a mark on the pane. -->
  <Style Selector="Border.pane.split">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="Border.pane.split.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <!--
    The divider between the two panes. What is seen is a hairline; what is grabbed
    is the transparent column around it, because a one-pixel target cannot be hit
    with a mouse. The usual trick of overhanging the neighbours with a negative
    margin is not available here: each pane holds a native web view with a window
    of its own, and it takes the pointer inside its bounds whatever Avalonia's z
    order says.
  -->
  <Style Selector="GridSplitter.pane-splitter">
    <Setter Property="Width" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Line"
                  Width="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource DividerBrush}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Lit while it is about to be dragged, and while it is being dragged. -->
  <Style Selector="GridSplitter.pane-splitter:pointerover /template/ Border#PART_Line">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <Style Selector="GridSplitter.pane-splitter:pressed /template/ Border#PART_Line">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <!-- ===== Floating panels ===== -->

  <Style Selector="Border.drawer-host">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- ===== Bookmarks ===== -->

  <!-- A star that means "saved" is yellow and filled in every browser there is,
       and it is the same yellow in a private window: this one marks a bookmark,
       which private mode keeps and does not hide. Literal rather than a palette
       token for exactly that reason — the private palette must not drain it. -->
  <Style Selector="Button.icon.bookmarked Path.glyph">
    <Setter Property="Fill" Value="#F5C242" />
    <Setter Property="Stroke" Value="#F5C242" />
  </Style>

  <Style Selector="Button.icon.bookmarked:pointerover Path.glyph">
    <Setter Property="Stroke" Value="#FFD766" />
    <Setter Property="Fill" Value="#FFD766" />
  </Style>

  <!-- Continuous with the toolbar above it: same ground, no dividing line, so
       the two read as one band of chrome rather than two stacked bars. The
       loading line below the bar is what separates chrome from page. -->
  <Style Selector="Border.bookmark-bar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="Padding" Value="6,0,6,5" />
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="Button.bookmark-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Path.glyph only carries a stroke inside Button.icon, so the folder and
       chevron glyphs in these rows drew as nothing until given one here. -->
  <Style Selector="Button.bookmark-item Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The label and glyphs brighten along with the fill, so a row lights up as
       one object instead of a rectangle appearing behind static contents. -->
  <Style Selector="Button.bookmark-item:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.bookmark-item:pointerover Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.bookmark-item.open Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.bookmark-item.drop-into Path.glyph">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="Button.bookmark-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- Held open while its dropdown is showing, so it is clear which folder the
       list below belongs to. -->
  <Style Selector="Button.bookmark-item.open">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.bookmark-item.open /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- The row a drag is hovering over, when the drop would file into it. -->
  <Style Selector="Button.bookmark-item.drop-into /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <Style Selector="Button.bookmark-item.drop-into">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Marks where a dragged row would land, between two others: upright on the
       bar, and lying flat inside a dropdown, where rows stack downwards. -->
  <Style Selector="Border.bookmark-drop-marker">
    <Setter Property="Width" Value="2" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Border.bookmark-drop-marker.horizontal">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="4,0" />
  </Style>

  <!-- Wider padding than the bar's rows: a dropdown is a list being read down,
       not a strip being scanned across. -->
  <Style Selector="Border.bookmark-folder-panel">
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="220" />
  </Style>

  <Style Selector="Border.bookmark-folder-panel Button.bookmark-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="TextBlock.bookmark-empty">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Margin" Value="10,8" />
  </Style>

  <!-- The scroll hint at the trailing edge of an overflowing saved-group strip.
       Fades the cut chip into the bar rather than slicing it flat. -->
  <Style Selector="Border.bookmark-group-fade">
    <Setter Property="Width" Value="28" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="{DynamicResource SurfaceBaseFaded}" />
          <GradientStop Offset="1" Color="{DynamicResource SurfaceBase}" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separates the saved tab groups from the ordinary bookmarks. -->
  <Style Selector="Border.bookmark-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,6" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <Style Selector="Border.bookmark-folder-list">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="ListBox.bookmark-folder-picker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.bookmark-folder-picker ListBoxItem">
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <!-- Same reason as the bar's rows: outside Button.icon a glyph has no stroke. -->
  <Style Selector="ListBox.bookmark-folder-picker Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Border.panel.drawer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ===== Zoom toast ===== -->

  <Style Selector="Border.zoom-toast">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
  </Style>

  <Style Selector="Button.zoom-toast-label">
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.zoom-toast-label /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.zoom-toast-label:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>

  <Style Selector="Button.panel-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="Border.panel-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.panel-row.exiting">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 3px) scale(0.96)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="Button.panel-row /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.panel-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.panel-row.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
  </Style>

  <Style Selector="Border.panel-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Border.panel-row.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
  </Style>

  <!-- ===== Navigation progress and status ===== -->

  <Style Selector="ProgressBar.navigation-progress">
    <Setter Property="Height" Value="1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MaxHeight" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
    <Setter Property="Foreground">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{DynamicResource BrandPrimary}" />
        <GradientStop Offset="1" Color="{DynamicResource BrandAccent}" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- ===== Local navigation error page ===== -->

  <Style Selector="Border.navigation-error-icon">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.navigation-error-headline">
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.35" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.navigation-error-message">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Border.navigation-error-hint">
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.navigation-error-hint TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Button.navigation-error-retry, Button.navigation-error-new-tab">
    <Setter Property="Padding" Value="17,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.navigation-error-retry">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.navigation-error-retry:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
  </Style>

  <Style Selector="Button.navigation-error-new-tab">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.navigation-error-new-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <!-- ===== Downloads panel ===== -->

  <Style Selector="TextBlock.downloads-heading">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBox.downloads-search">
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.downloads-empty-icon">
    <Setter Property="Width" Value="72" />
    <Setter Property="Height" Value="72" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Path.downloads-empty-glyph">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource BrandAccentBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.downloads-empty-title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.downloads-empty-copy">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.download-show-all">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <Style Selector="Button.download-show-all /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.download-show-all:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.download-clear">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Button.download-clear /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.download-clear:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="TextBlock.downloads-empty">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Padding" Value="8,18" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.download-row">
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="Border.download-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.download-body">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="Button.download-body /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.download-file-badge">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Path.download-file-glyph">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.download-name">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.download-status">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="ProgressBar.download-progress">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="MaxHeight" Value="3" />
    <Setter Property="Margin" Value="0,2,0,1" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

</Styles>
