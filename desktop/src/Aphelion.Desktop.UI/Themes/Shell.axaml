<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Aphelion.Desktop.UI.Controls">

  <!-- ===== Typography =====

       Inter throughout, bundled with the application rather than relying on a
       system font, so the interface looks the same on Windows, macOS and Linux.
       Google Sans, which inspired the look, is proprietary and cannot ship in an
       AGPL project; Inter is the closest open-licensed equivalent. -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <!-- Scrolling tab title -->
  <Style Selector="controls|MarqueeTextBlock">
    <Setter Property="Template">
      <ControlTemplate>
        <TextBlock Name="PART_Text"
                   Text="{TemplateBinding Text}"
                   FontSize="{TemplateBinding FontSize}"
                   FontFamily="{TemplateBinding FontFamily}"
                   Foreground="{TemplateBinding Foreground}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   TextTrimming="CharacterEllipsis" />
      </ControlTemplate>
    </Setter>
  </Style>

  <!--
    Shell chrome styling.

    All glyphs are vector Path data rather than icon-font characters: the icon
    fonts present on Windows do not exist on macOS or Linux, where they would
    render as replacement boxes.
  -->

  <!-- ===== Title bar ===== -->

  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- ===== Tabs ===== -->

  <!-- Slide animation for reordering lives on the item containers and is driven
       by TabStripDragHandler; only the hover colour animates from here. -->
  <!-- Width comes from TabStripPanel, which shares the strip evenly between
       tabs; a MinWidth or MaxWidth here would fight that. -->
  <Style Selector="Border.tab">
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Group chips -->
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.chip:pointerover Border.chip-pill">
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.chip-pill">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,3" />
  </Style>
  <Style Selector="TextBlock.chip-text">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundOnAccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- The active tab is lifted out of the title bar with a lighter fill and a
       hairline border; without the border the two surfaces read as one block. -->
  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.tab controls|MarqueeTextBlock.tab-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Border.tab.active controls|MarqueeTextBlock.tab-title">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <!-- Favicon, and the placeholder shown before one arrives -->
  <Style Selector="Image.favicon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Separates the two halves of a split pair in the strip -->
  <Style Selector="Border.split-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- A split pair carries a hairline outline so it is recognisable as a pair
       even at the narrowest width, where the second favicon is all that shows. -->
  <Style Selector="Border.tab.split">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The partner's title, styled like the primary one -->
  <Style Selector="Border.tab controls|MarqueeTextBlock.tab-title-partner">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="Border.tab.active controls|MarqueeTextBlock.tab-title-partner">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Path.favicon-fallback">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!-- Group marker: a rounded bar in the group's colour -->
  <Style Selector="Border.group-marker">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="14" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Icon buttons: tab close, chrome actions ===== -->

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="Button.icon Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon:pointerover Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="Button.icon:disabled Path.glyph">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- ===== Caption buttons ===== -->

  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CloseHoverBrush}" />
  </Style>

  <Style Selector="Path.caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption.close:pointerover Path.caption-glyph">
    <Setter Property="Stroke" Value="{DynamicResource ForegroundOnAccentBrush}" />
  </Style>

  <!-- ===== Address bar ===== -->

  <Style Selector="TextBox.address">
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
  </Style>

  <Style Selector="TextBox.address:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

  <Style Selector="TextBox.address:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- ===== New tab page ===== -->

  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ===== Menus =====

       One global look for every context menu in the application. Menus defined
       anywhere pick this up automatically; no menu carries local styling. -->

  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- An editor hosted inside a menu item, e.g. renaming a group -->
  <Style Selector="TextBox.menu-editor">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
  </Style>

  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,4" />
  </Style>

  <!-- ===== Split panes =====

       Only a split shows the focus border; a single pane has nothing to
       distinguish itself from. -->

  <Style Selector="Border.pane">
    <Setter Property="BorderThickness" Value="0" />
    <!-- The web view is a native control and will happily paint past its
         bounds; without clipping the right pane spills over the window edge. -->
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.pane.split">
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.pane.split.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
  </Style>

  <!-- ===== Floating panels ===== -->

  <!-- Dimmed backdrop that also catches the click that dismisses the panel -->
  <Style Selector="Panel.scrim">
    <Setter Property="Background" Value="#66000000" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MaxHeight" Value="520" />
  </Style>

  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>

  <Style Selector="Button.panel-row">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="Button.panel-row /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.panel-row:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- ===== Status bar ===== -->

  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}" />
  </Style>

</Styles>
