<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             xmlns:views="using:Aphelion.Desktop.UI.Views"
             x:Class="Aphelion.Desktop.UI.Views.NewTabPage"
             x:DataType="vm:NewTabPageViewModel"
             Background="{DynamicResource NewTabBackdropBrush}"
             ClipToBounds="True">
  <UserControl.Resources>
    <DataTemplate x:Key="SearchEngineLogoTemplate" x:DataType="vm:SearchEngineOptionViewModel">
      <Grid Width="24" Height="24">
        <Border CornerRadius="12"
                Background="{DynamicResource NewTabGlassHoverBrush}"
                IsVisible="{Binding !HasIcon}">
          <TextBlock Text="{Binding FallbackText}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource NewTabForegroundBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Image Source="{Binding Icon}"
               Width="22"
               Height="22"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               IsVisible="{Binding HasIcon}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SelectedSearchEngineLogoTemplate" x:DataType="vm:SearchEngineOptionViewModel">
      <Grid Width="42" Height="42">
        <Border CornerRadius="21"
                Background="{DynamicResource NewTabGlassHoverBrush}"
                IsVisible="{Binding !HasIcon}">
          <TextBlock Text="{Binding FallbackText}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource NewTabForegroundBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <Image Source="{Binding Icon}"
               Width="42"
               Height="42"
               Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               IsVisible="{Binding HasIcon}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <views:NewTabBackground IsVisible="{Binding !IsPrivate}" />
    <views:NewTabPrivateBackground IsVisible="{Binding IsPrivate}" />

    <!--
      Weather resolves an approximate location from the public IP on its own,
      before the user has asked for anything — the one thing on this page that
      reaches the network unprompted. Both states stay reachable from the same
      corner: on, the card refreshes on click and offers "Turn off" in its menu;
      off, a small label takes its place and turns it back on.

      Private mode carries neither: no weather card, no "off" label to turn it
      back on from. The page stays as quiet as the rest of the private
      experience rather than offering a network request it otherwise never
      makes on its own.
    -->
    <Button Classes="newtab-weather"
            Margin="0,20,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding Ambient.RefreshWeatherCommand}"
            IsVisible="{Binding Ambient.IsWeatherEnabled}"
            ToolTip.Tip="{Binding Ambient.WeatherDescription}">
      <Button.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Turn off weather" Command="{Binding Ambient.ToggleWeatherCommand}" />
        </ContextMenu>
      </Button.ContextMenu>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Classes="newtab-weather-location" Text="{Binding Ambient.WeatherLocation}" />
          <TextBlock Classes="newtab-weather-condition" Text="{Binding Ambient.WeatherDescription}" />
        </StackPanel>
        <Canvas Width="32" Height="25" VerticalAlignment="Center">
          <Ellipse Canvas.Left="15" Canvas.Top="1" Width="11" Height="11"
                   Fill="{DynamicResource NewTabWarmBrush}" Opacity="0.92" />
          <Path Canvas.Left="2" Canvas.Top="8" Width="27" Height="15"
                Stretch="Fill" Fill="{DynamicResource NewTabForegroundBrush}"
                Data="M7,14 C3,14 1,11.5 1,8.7 C1,5.8 3.3,3.5 6.2,3.5 C7.5,1.4 9.8,0 12.5,0 C16.5,0 19.8,3 20.2,6.8 C23.4,6.9 26,9.2 26,12 C26,13.1 25.6,14 25,14 Z" />
        </Canvas>
        <TextBlock Classes="newtab-weather-temperature" Text="{Binding Ambient.TemperatureText}" />
      </StackPanel>
    </Button>

    <Button Classes="newtab-weather-off"
            Margin="0,20,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding Ambient.ToggleWeatherCommand}"
            IsVisible="{Binding ShowWeatherOffLabel}"
            ToolTip.Tip="Turn weather back on">
      <TextBlock Text="Weather off" />
    </Button>

    <StackPanel Width="820" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
      <StackPanel Spacing="18">
        <Grid Classes="newtab-logo-mark" HorizontalAlignment="Center" IsHitTestVisible="False"
              IsVisible="{Binding !IsPrivate}"
              RenderTransform="translate(0px,-16px)">
          <Image Classes="newtab-logo-glow"
                 Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <Image Classes="newtab-logo-image"
                 Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Grid>
        <StackPanel Classes="newtab-greeting" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" IsVisible="{Binding !IsPrivate}">
          <TextBlock Classes="newtab-greeting-headline" Text="{Binding Ambient.GreetingHeadline}" />
          <TextBlock Classes="newtab-greeting-prompt" Text="{Binding Ambient.GreetingPrompt}" />
        </StackPanel>
        <!-- The same mark as the ordinary New Tab page, not a distinct glyph:
             a private window is still Aphelion, just quieter. Colour comes from
             Classes.private on Image.newtab-logo-image, which desaturates it
             towards the muted tone rather than swapping in a different image. -->
        <StackPanel HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding IsPrivate}">
          <Image Classes="newtab-logo-image private"
                 Width="76" Height="76"
                 HorizontalAlignment="Center"
                 Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Private Mode" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource NewTabForegroundBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Aphelion won't save this window to your history or session. Cookies and site data are cleared when you close it."
                     FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                     Foreground="{DynamicResource NewTabMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <Grid Name="NewTabSearchAnchor" Height="58" ClipToBounds="False">
          <Border Name="NewTabSearchSurface"
                  Classes="newtab-search"
                  Classes.suggestions-open="{Binding Search.HasSuggestions}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
              <Grid>
                <Button Name="SearchEngineButton"
                        Classes="newtab-engine-trigger"
                        Command="{Binding SearchEngines.ToggleCommand}"
                        ToolTip.Tip="Choose search engine">
                  <ContentControl Content="{Binding SearchEngines.Selected}"
                                  ContentTemplate="{StaticResource SelectedSearchEngineLogoTemplate}" />
                </Button>
                <Popup IsOpen="{Binding SearchEngines.IsOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=SearchEngineButton}"
                       Placement="Bottom"
                       VerticalOffset="8"
                       IsLightDismissEnabled="True">
                  <Border Classes="newtab-engine-picker">
                    <StackPanel Spacing="4">
                      <TextBlock Text="SEARCH WITH" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.1"
                                 Foreground="{DynamicResource NewTabMutedBrush}" Margin="8,4,8,5" />
                      <ItemsControl ItemsSource="{Binding SearchEngines.Options}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SearchEngineOptionViewModel">
                            <Button Classes="newtab-engine-option" Click="OnSearchEngineSelected">
                              <StackPanel Orientation="Horizontal" Spacing="10">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SearchEngineLogoTemplate}" />
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{DynamicResource NewTabForegroundBrush}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="newtab-engine-picker-divider" />
                      <!-- The one setting that belongs beside the engine choice: it
                           decides whether keystrokes go to that engine's suggestion
                           endpoint before Enter is pressed. -->
                      <Button Classes="newtab-engine-option" Command="{Binding Search.ToggleSuggestionsCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="Search suggestions" FontSize="12.5" FontWeight="Medium"
                                     Foreground="{DynamicResource NewTabForegroundBrush}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"
                                     Foreground="{DynamicResource NewTabMutedBrush}"
                                     Text="{Binding Search.SuggestionsStateLabel}" />
                        </Grid>
                      </Button>
                    </StackPanel>
                  </Border>
                </Popup>
              </Grid>
              <TextBox Name="SearchBox" Grid.Column="1" Classes="newtab-search-box" Text="{Binding Search.SearchText}" PlaceholderText="Search the web or enter an address" GotFocus="OnSearchBoxGotFocus">
                <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Search.SearchCommand}" /></TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="2" Classes="newtab-search-submit" Command="{Binding Search.SearchCommand}" ToolTip.Tip="Search">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource NewTabForegroundBrush}" StrokeThickness="1.7" Data="M2,8 H14 M9,3 L14,8 L9,13" />
              </Button>
            </Grid>
          </Border>
          <!--
            IsLightDismissEnabled matters here in a way it does not for the
            engine picker above: this page can leave the visual tree entirely
            when the user switches tabs, and a Popup is its own top-level
            window at the OS level — it does not close just because the page
            that opened it is no longer showing. Without this, choosing a
            different tab while suggestions were open left the list floating
            over whatever page came next. NewTabSearchBoxViewModel also clears
            Suggestions on IsVisibleChanged for the same reason from the other
            side: the popup binds to HasSuggestions, so an empty list closes
            it even if light dismiss did not fire.
          -->
          <Popup IsOpen="{Binding Search.HasSuggestions, Mode=OneWay}"
                 Placement="Bottom"
                 PlacementTarget="{Binding ElementName=NewTabSearchAnchor}"
                 IsLightDismissEnabled="True"
                 Closed="OnSuggestionsPopupClosed">
            <Border Classes="newtab-suggestions"
                    Width="{Binding Bounds.Width, ElementName=NewTabSearchSurface}">
              <ItemsControl ItemsSource="{Binding Search.Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="newtab-suggestion" Click="OnSearchSuggestionSelected">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource NewTabMutedBrush}"
                              StrokeThickness="1.5" VerticalAlignment="Center"
                              Data="M6.2,1 A5.2,5.2 0 1 0 6.2,11.4 A5.2,5.2 0 1 0 6.2,1 M10.1,10.1 L14,14" />
                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource NewTabForegroundBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </Popup>
        </Grid>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding ShortcutTiles}" HorizontalAlignment="Center" IsVisible="{Binding !IsPrivate}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:NewTabShortcutViewModel">
            <Button Classes="newtab-shortcut" Click="OnOpenShortcut">
              <Button.ContextMenu><ContextMenu><MenuItem Header="Edit" Click="OnRenameShortcut" /><MenuItem Header="Remove" Click="OnRemoveShortcut" /></ContextMenu></Button.ContextMenu>
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Classes="newtab-shortcut-tile">
                  <Grid>
                    <TextBlock Text="{Binding FallbackText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource NewTabForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasFavicon}" />
                    <Image Source="{Binding Favicon}" Width="25" Height="25" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" IsVisible="{Binding HasFavicon}" />
                  </Grid>
                </Border>
                <TextBlock Classes="newtab-shortcut-label" Width="92" Text="{Binding Name}" TextAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
          <DataTemplate DataType="vm:AddNewTabShortcutViewModel">
            <Button Classes="newtab-shortcut" Click="OnAddShortcut">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Classes="newtab-shortcut-tile newtab-shortcut-add"><Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource NewTabForegroundBrush}" StrokeThickness="1.5" Data="M8,1 V15 M1,8 H15" /></Border>
                <TextBlock Classes="newtab-shortcut-label" Width="92" Text="Add shortcut" TextAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
    </StackPanel>

    <Border Background="#99000000" IsVisible="{Binding IsEditorOpen}">
      <Border Classes="newtab-glass" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding EditorHeading}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NewTabForegroundBrush}" />
          <StackPanel Spacing="7"><TextBlock Classes="newtab-muted" Text="Name" FontSize="12" /><TextBox Text="{Binding EditorName}" MaxLength="32" PlaceholderText="Shortcut name" /></StackPanel>
          <StackPanel Spacing="7"><TextBlock Classes="newtab-muted" Text="Address" FontSize="12" /><TextBox Text="{Binding EditorAddress}" PlaceholderText="https://example.com" /></StackPanel>
          <TextBlock Text="{Binding EditorError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasEditorError}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Cancel" Command="{Binding CancelEditorCommand}" /><Button Classes="primary" Content="Save" Command="{Binding SaveShortcutCommand}" /></StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
