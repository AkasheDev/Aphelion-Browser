<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             xmlns:web="using:Avalonia.Controls"
             xmlns:views="using:Aphelion.Desktop.UI.Views"
             x:Class="Aphelion.Desktop.UI.Views.BrowserView"
             x:DataType="vm:BrowserViewModel">

  <!-- The page only. Navigation controls live in the window's single toolbar,
       so a split shows two pages under one address bar rather than two of
       everything. -->
  <DockPanel>

    <Border DockPanel.Dock="Bottom"
            Classes="statusbar"
            IsVisible="{Binding StatusText,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusText}" />
    </Border>

    <Panel Background="{DynamicResource SurfaceBaseBrush}">

      <web:NativeWebView Name="WebView" IsVisible="{Binding ShouldShowWebView}" />

      <Panel IsVisible="{Binding IsBlank}">
        <views:NewTabPage DataContext="{Binding NewTab}" />
      </Panel>

      <views:NavigationErrorPage DataContext="{Binding ErrorPage}"
                                 IsVisible="{Binding IsVisible}" />

    </Panel>

  </DockPanel>

</UserControl>
