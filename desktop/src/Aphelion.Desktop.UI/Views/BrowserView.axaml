<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             xmlns:web="using:Avalonia.Controls"
             x:Class="Aphelion.Desktop.UI.Views.BrowserView"
             x:DataType="vm:BrowserViewModel">

  <DockPanel>

    <!-- Toolbar -->
    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          Margin="6,6,10,6"
          ColumnSpacing="2"
          Background="{DynamicResource SurfaceBaseBrush}">

      <Button Grid.Column="0" Classes="icon" ToolTip.Tip="Back"
              Command="{Binding GoBackCommand}">
        <Path Classes="glyph" Data="M8,1 L3,6.5 L8,12" />
      </Button>

      <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Forward"
              Command="{Binding GoForwardCommand}">
        <Path Classes="glyph" Data="M4,1 L9,6.5 L4,12" />
      </Button>

      <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Reload"
              Command="{Binding ReloadCommand}"
              IsVisible="{Binding !IsLoading}">
        <Path Classes="glyph"
              Data="M12,6.5 A5.5,5.5 0 1 1 10.1,2.3 M12.3,0 V3.2 H9.1" />
      </Button>

      <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Stop"
              Command="{Binding StopLoadingCommand}"
              IsVisible="{Binding IsLoading}">
        <Path Classes="glyph" Data="M2,2 L11,11 M11,2 L2,11" />
      </Button>

      <!-- Split and grouping sit beside reload, as in Chrome. Both act on the
           window rather than this page, so they reach the shell through the
           view's own DataContext chain. -->
      <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Split view"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Shell.ToggleSplitCommand}">
        <Path Classes="glyph" Data="M1,1 H12 V12 H1 Z M6.5,1 V12" />
      </Button>

      <Button Grid.Column="4" Classes="icon" ToolTip.Tip="Group or ungroup this tab"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Shell.GroupActiveTabCommand}">
        <Path Classes="glyph" Data="M0.5,2.5 H12.5 V10.5 H0.5 Z M4.5,2.5 V10.5" />
      </Button>

      <TextBox Grid.Column="5"
               Classes="address"
               Margin="8,0,0,0"
               Text="{Binding AddressText}"
               PlaceholderText="Search or enter address">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding NavigateCommand}" />
        </TextBox.KeyBindings>
      </TextBox>

    </Grid>

    <!-- Status bar, shown only while there is something to report -->
    <Border DockPanel.Dock="Bottom"
            Classes="statusbar"
            IsVisible="{Binding StatusText,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusText}" />
    </Border>

    <!-- Page -->
    <Panel Background="{DynamicResource SurfaceBaseBrush}">

      <web:NativeWebView Name="WebView" IsVisible="{Binding !IsBlank}" />

      <StackPanel IsVisible="{Binding IsBlank}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10">
        <Image Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
               Width="72" Height="72"
               HorizontalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Classes="wordmark" Text="Aphelion" />
        <TextBlock Classes="subtle" Text="Search or enter an address to begin." />
      </StackPanel>

    </Panel>

  </DockPanel>

</UserControl>
