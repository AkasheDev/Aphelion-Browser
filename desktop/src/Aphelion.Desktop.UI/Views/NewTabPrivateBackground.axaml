<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aphelion.Desktop.UI.Views.NewTabPrivateBackground"
             IsHitTestVisible="False"
             ClipToBounds="True">

  <!--
    Private mode's backdrop: one flat, near-black field, where the ordinary New
    Tab page has its starfield. It used to carry a tiled hairline grid and a
    vignette; both are gone. Texture is decoration, and decoration is the thing
    private mode has least use for — the page states plainly that nothing here
    is being kept, and the backdrop should say the same by showing nothing at
    all. Nothing is drawn per frame, matching the page's own stillness: no
    weather, no shortcuts, no greeting.
  -->
  <Grid Background="{DynamicResource NewTabBackdropBrush}" />
</UserControl>
