<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel"
             Background="{DynamicResource SurfaceBaseBrush}"
             ClipToBounds="True">

  <!-- aphelion://downloads. A full page rather than a bubble: a native WebView
       paints over Avalonia overlays, so this takes the tab content column. The
       masthead and the rules are the same as the history, because a list of
       files and a list of pages are the same kind of document. -->
  <DockPanel>

    <StackPanel DockPanel.Dock="Top"
                Margin="48,40,48,0"
                MaxWidth="880"
                Spacing="20">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="page-title" Text="Downloads" />
          <TextBlock Classes="page-lede" Text="Everything this profile has pulled off the web." />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom"
                    Margin="24,0,0,2">
          <TextBlock Classes="page-count" Text="{Binding TotalLabel}" />
          <TextBlock Classes="page-count" Text="/" />
          <TextBlock Classes="page-count" Text="{Binding ActiveLabel}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBox Grid.Column="0"
                 Classes="page-search"
                 Width="360"
                 HorizontalAlignment="Left"
                 PlaceholderText="Search downloads"
                 Text="{Binding SearchText}" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button Classes="page-ghost"
                  Content="Open folder"
                  Command="{Binding OpenDownloadsFolderCommand}" />
          <Button Classes="page-ghost danger"
                  Content="Clear all"
                  Command="{Binding ClearFinishedCommand}"
                  IsVisible="{Binding HasDownloads}" />
        </StackPanel>
      </Grid>

      <Border Classes="page-rule" />
    </StackPanel>

    <Panel Margin="48,0,48,0">

      <!-- Nothing has ever been downloaded. -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="16"
                  IsVisible="{Binding !HasDownloads}">
        <Border Classes="page-empty-icon" HorizontalAlignment="Center">
          <Path Classes="page-empty-glyph"
                Data="M16,5 V21 M9,14.5 L16,21.5 L23,14.5 M6,26 H26" />
        </Border>
        <StackPanel Spacing="6">
          <TextBlock Classes="page-empty-title" Text="Nothing downloaded yet" />
          <TextBlock Classes="page-empty-copy"
                     Text="Files you save from the web land here, with their progress, source and a way back to the folder they went to." />
        </StackPanel>
      </StackPanel>

      <!-- Downloads exist, but not with that search in the box. -->
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="6"
                  IsVisible="{Binding HasNoSearchMatches}">
        <TextBlock Classes="page-empty-title" Text="No matching downloads" />
        <TextBlock Classes="page-empty-copy" Text="Nothing in this profile matches that search." />
      </StackPanel>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding HasVisibleDownloads}">
        <ItemsControl ItemsSource="{Binding VisibleItems}"
                      MaxWidth="880"
                      Margin="0,8,0,40">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadItemViewModel">

              <Border Classes="page-row">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                  <Border Grid.Column="0"
                          Classes="page-tile"
                          Classes.document="{Binding IsDocumentKind}"
                          Classes.image="{Binding IsImageKind}"
                          Classes.media="{Binding IsMediaKind}"
                          Classes.archive="{Binding IsArchiveKind}"
                          Classes.code="{Binding IsCodeKind}">
                    <TextBlock Classes="download-tile-text" Text="{Binding TypeBadge}" />
                  </Border>

                  <Button Grid.Column="1"
                          Classes="download-open"
                          Command="{Binding OpenFileCommand}"
                          ToolTip.Tip="{Binding FilePath}">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Classes="download-title"
                                 Text="{Binding FileName}"
                                 TextTrimming="CharacterEllipsis" />

                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="10"
                            IsVisible="{Binding ShowsProgress}">
                        <ProgressBar Grid.Column="0"
                                     Classes="download-bar"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Classes="download-percent"
                                   Text="{Binding ProgressLabel}" />
                      </Grid>

                      <TextBlock Classes="download-meta"
                                 Text="{Binding StatusText}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>

                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="2"
                              VerticalAlignment="Center">

                    <Button Classes="icon small" ToolTip.Tip="Pause"
                            IsVisible="{Binding CanPause}"
                            Command="{Binding PauseCommand}">
                      <Path Classes="glyph" Data="M3,1.5 V10.5 M8,1.5 V10.5" />
                    </Button>

                    <Button Classes="icon small" ToolTip.Tip="Resume"
                            IsVisible="{Binding CanResume}"
                            Command="{Binding ResumeCommand}">
                      <Path Classes="glyph" Data="M3,1.5 L9.5,6 L3,10.5 Z" />
                    </Button>

                    <Button Classes="icon small" ToolTip.Tip="Cancel"
                            IsVisible="{Binding CanCancel}"
                            Command="{Binding CancelCommand}">
                      <Path Classes="glyph" Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>

                    <Button Classes="icon small" ToolTip.Tip="Show in folder"
                            IsVisible="{Binding CanOpenFile}"
                            Command="{Binding RevealInFolderCommand}">
                      <Path Classes="glyph" Data="M1,2.5 H4.7 L6,4 H11 V9.5 H1 Z" />
                    </Button>

                    <Button Classes="icon small" ToolTip.Tip="Remove from list"
                            IsVisible="{Binding CanRemove}"
                            Command="{Binding RemoveCommand}">
                      <Path Classes="glyph" Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>

                  </StackPanel>

                </Grid>
              </Border>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>

  </DockPanel>

</UserControl>
