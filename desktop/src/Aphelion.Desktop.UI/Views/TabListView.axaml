<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.TabListView"
             x:DataType="vm:TabListViewModel">

  <!-- Shared by the overflow panel and the split picker: same list, same paging,
       different title and different action on choosing a row. -->
  <Border Classes="panel" Width="320">
    <Grid RowDefinitions="Auto,*,Auto">

      <TextBlock Grid.Row="0"
                 Classes="panel-title"
                 Text="{Binding Title}" />

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Page}">
          <ItemsControl.ItemTemplate>
            <!-- A row carries the same marks as the tab it stands for: its group's
                 colour, and both favicons when it is a split pair. -->
            <DataTemplate DataType="vm:TabItemViewModel">
              <Button Classes="panel-row"
                      Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).ChooseCommand}"
                      CommandParameter="{Binding}">

                <!-- The same menu the strip offers, on the same commands: a tab
                     listed here is still a tab. Suppressed for a list that only
                     picks — see ContextRequested in the code-behind. -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Add to new group"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.GroupActiveTabCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding !IsGrouped}" />
                    <MenuItem Header="Remove from group"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.UngroupTabCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsGrouped}" />
                    <Separator />
                    <MenuItem Header="Open in split view"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.SplitWithTabCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding !IsActive}" />
                    <MenuItem Header="Close left side"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.CloseLeftSideCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsSplit}" />
                    <MenuItem Header="Close right side"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.CloseRightSideCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsSplit}" />
                    <MenuItem Header="Close split view"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.CloseSplitCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsSplit}" />
                    <Separator />
                    <MenuItem Header="Move to new window"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.MoveTabToNewWindowCommand}"
                              CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Close tab"
                              Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).Owner.CloseTabCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Button.ContextMenu>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                  <Border Grid.Column="0"
                          Classes="group-marker"
                          IsVisible="{Binding IsGrouped}"
                          Background="{Binding GroupBrush}" />

                  <Image Grid.Column="1"
                         Classes="favicon"
                         Source="{Binding Favicon}"
                         RenderOptions.BitmapInterpolationMode="HighQuality"
                         IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Path Grid.Column="1"
                        Classes="favicon-fallback"
                        Width="13" Height="13"
                        Data="M1,6.5 A5.5,5.5 0 1 0 12,6.5 A5.5,5.5 0 1 0 1,6.5 M1,6.5 H12 M6.5,1 A8,8 0 0 1 6.5,12 A8,8 0 0 1 6.5,1"
                        IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNull}}" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding Title}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <Border Grid.Column="3"
                          Classes="split-divider"
                          IsVisible="{Binding IsSplit}" />

                  <Image Grid.Column="4"
                         Classes="favicon"
                         Margin="0"
                         Source="{Binding PartnerFavicon}"
                         RenderOptions.BitmapInterpolationMode="HighQuality"
                         IsVisible="{Binding PartnerFavicon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <Path Grid.Column="4"
                        Classes="favicon-fallback"
                        Width="13" Height="13"
                        Margin="0"
                        Data="M1,6.5 A5.5,5.5 0 1 0 12,6.5 A5.5,5.5 0 1 0 1,6.5 M1,6.5 H12 M6.5,1 A8,8 0 0 1 6.5,12 A8,8 0 0 1 6.5,1"
                        IsVisible="{Binding ShowsPartnerFallback}" />

                  <Button Grid.Column="5"
                          Classes="icon small"
                          Margin="8,0,0,0"
                          ToolTip.Tip="Close tab"
                          IsVisible="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).CanClose}"
                          Command="{Binding $parent[ItemsControl].((vm:TabListViewModel)DataContext).CloseCommand}"
                          CommandParameter="{Binding}">
                    <Path Classes="glyph" Data="M0,0 L8,8 M8,0 L0,8" />
                  </Button>

                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Row="1"
                 Classes="subtle"
                 Margin="0,16"
                 VerticalAlignment="Top"
                 Text="Nothing to show."
                 IsVisible="{Binding IsEmpty}" />

      <!-- Offered by the split picker so the user can always choose a second
           page, even when no other tab is open. -->
      <Button Grid.Row="1"
              Classes="panel-row"
              VerticalAlignment="Bottom"
              IsVisible="{Binding CanCreateNew}"
              Command="{Binding CreateNewCommand}">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Classes="glyph"
                Stroke="{DynamicResource ForegroundMutedBrush}"
                StrokeThickness="1.3"
                Width="13" Height="13"
                Margin="0,0,9,0"
                VerticalAlignment="Center"
                Data="M6.5,1 V12 M1,6.5 H12" />
          <TextBlock Grid.Column="1" Text="New tab" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <!-- Paging, hidden when everything fits on one page -->
      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto"
            Margin="0,8,0,0"
            IsVisible="{Binding HasPages}">
        <Button Grid.Column="0" Classes="icon" ToolTip.Tip="Previous page"
                Command="{Binding PreviousPageCommand}"
                IsEnabled="{Binding CanGoPrevious}">
          <Path Classes="glyph" Data="M8,1 L3,6.5 L8,12" />
        </Button>
        <TextBlock Grid.Column="1" Classes="subtle" Text="{Binding PageLabel}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Next page"
                Command="{Binding NextPageCommand}"
                IsEnabled="{Binding CanGoNext}">
          <Path Classes="glyph" Data="M4,1 L9,6.5 L4,12" />
        </Button>
      </Grid>

    </Grid>
  </Border>

</UserControl>
