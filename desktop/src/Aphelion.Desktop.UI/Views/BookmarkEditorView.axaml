<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.BookmarkEditorView"
             x:DataType="vm:BookmarkEditorViewModel">

  <!-- The form the star opens: name the page, choose where it goes. The folder
       list is flat and indented rather than a set of cascading menus — picking a
       destination wants every option visible at once, which is a different task
       from walking the bar. -->
  <Border Classes="panel" Width="320" Padding="14">
    <StackPanel Spacing="12">

      <TextBlock Classes="panel-title" Text="{Binding Heading}" Margin="0" />

      <StackPanel Spacing="6">
        <TextBlock Text="Name" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
        <TextBox Name="NameBox" Text="{Binding Name}" MaxLength="120" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Folder" FontSize="11.5" Foreground="{DynamicResource ForegroundMutedBrush}" />
        <Border Classes="bookmark-folder-list">
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
            <ListBox ItemsSource="{Binding Folders}"
                     SelectedItem="{Binding SelectedFolder}"
                     Classes="bookmark-folder-picker">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BookmarkFolderRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}">
                    <Path Classes="glyph" Width="12" Height="12" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="M1,3 H5.5 L7,4.8 H12 V11 H1 Z" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="Remove"
                Command="{Binding RemoveCommand}"
                IsVisible="{Binding IsEditing}" />
        <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Grid.Column="3" Classes="primary" Content="Done" Command="{Binding SaveCommand}" />
      </Grid>

    </StackPanel>
  </Border>

</UserControl>
