<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.NavigationErrorPage"
             x:DataType="vm:NavigationErrorPageViewModel"
             Background="{DynamicResource SurfaceBaseBrush}"
             ClipToBounds="True">

  <!-- Not an aphelion:// address of its own - it stands in for the page that
       failed - but it is drawn by the application, so it is built from the same
       parts as the pages that are. A failed navigation is the last moment to
       decorate: nothing here is coloured except the one button worth pressing. -->
  <StackPanel Width="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="18">

    <Border Classes="page-empty-icon" HorizontalAlignment="Center">
      <Path Classes="page-empty-glyph"
            Data="M3,16 A13,13 0 1 1 29,16 A13,13 0 1 1 3,16 M3,16 H29 M16,3 C12,6.5 11,11 11,16 C11,21 12,25.5 16,29 M16,3 C20,6.5 21,11 21,16 C21,21 20,25.5 16,29" />
    </Border>

    <StackPanel Spacing="8">
      <TextBlock Classes="page-empty-title"
                 FontSize="{DynamicResource TypeTitle}"
                 Text="{Binding Headline}"
                 TextWrapping="Wrap" />
      <TextBlock Classes="page-empty-copy"
                 MaxWidth="420"
                 Text="{Binding Message}" />
    </StackPanel>

    <Border Classes="page-note" HorizontalAlignment="Center">
      <TextBlock Classes="settings-hint"
                 MaxWidth="400"
                 TextAlignment="Center"
                 Text="{Binding Hint}" />
    </Border>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8"
                Margin="0,4,0,0">
      <Button Classes="page-primary" Content="Try again" Command="{Binding RetryCommand}" />
      <Button Classes="page-ghost" Content="Go back" Command="{Binding OpenNewTabCommand}" />
    </StackPanel>

  </StackPanel>

</UserControl>
