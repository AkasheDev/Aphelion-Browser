<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.NavigationErrorPage"
             x:DataType="vm:NavigationErrorPageViewModel"
             Background="{DynamicResource SurfaceBaseBrush}">
  <Grid Margin="32">
    <StackPanel Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="17">
      <Border Classes="navigation-error-icon" HorizontalAlignment="Center">
        <Path Width="31" Height="31"
              Stretch="Uniform"
              Stroke="{DynamicResource BrandAccentBrush}"
              StrokeThickness="1.7"
              StrokeLineCap="Round"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Data="M3,16 A13,13 0 1 1 29,16 A13,13 0 1 1 3,16 M3,16 H29 M16,3 C12,6.5 11,11 11,16 C11,21 12,25.5 16,29 M16,3 C20,6.5 21,11 21,16 C21,21 20,25.5 16,29 M14,16 H18 M16,13 V19" />
      </Border>

      <StackPanel Spacing="8" HorizontalAlignment="Center">
        <TextBlock Classes="navigation-error-headline" Text="{Binding Headline}" TextAlignment="Center" />
        <TextBlock Classes="navigation-error-message" Text="{Binding Message}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="navigation-error-hint">
        <TextBlock Text="{Binding Hint}" TextAlignment="Center" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,5,0,0">
        <Button Classes="navigation-error-retry" Command="{Binding RetryCommand}">Try again</Button>
        <Button Classes="navigation-error-new-tab" Command="{Binding OpenNewTabCommand}">Go back</Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
