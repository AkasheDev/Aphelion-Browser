<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             xmlns:views="using:Aphelion.Desktop.UI.Views"
             x:Class="Aphelion.Desktop.UI.Views.BrowserToolbarView"
             x:DataType="vm:MainWindowViewModel">

  <!--
    One toolbar for the window, not one per pane. In split view Chrome keeps a
    single address bar driving whichever pane is active; two toolbars would
    duplicate every control and halve the address bar for no gain.

    Navigation binds to the active browser; split and grouping act on the window.
  -->
  <Grid Background="{DynamicResource SurfaceBaseBrush}"
        DataContext="{Binding}">

    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
          Margin="6,6,10,6"
          ColumnSpacing="2">

      <Button Grid.Column="0" Classes="icon" ToolTip.Tip="Back"
            Command="{Binding Shell.FocusedBrowser.GoBackCommand}">
      <Path Classes="glyph" Data="M8,1 L3,6.5 L8,12" />
      </Button>

      <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Forward"
            Command="{Binding Shell.FocusedBrowser.GoForwardCommand}">
      <Path Classes="glyph" Data="M4,1 L9,6.5 L4,12" />
      </Button>

      <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Reload"
            Command="{Binding Shell.FocusedBrowser.ReloadCommand}"
            IsVisible="{Binding !Shell.FocusedBrowser.IsLoading}">
      <Path Classes="glyph"
            Data="M12,6.5 A5.5,5.5 0 1 1 10.1,2.3 M12.3,0 V3.2 H9.1" />
      </Button>

      <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Stop"
            Command="{Binding Shell.FocusedBrowser.StopLoadingCommand}"
            IsVisible="{Binding Shell.FocusedBrowser.IsLoading}">
      <Path Classes="glyph" Data="M2,2 L11,11 M11,2 L2,11" />
      </Button>

      <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Split view"
            Command="{Binding Shell.ToggleSplitCommand}">
      <Path Classes="glyph" Data="M1,1 H12 V12 H1 Z M6.5,1 V12" />
      </Button>


      <!-- Sits against the address box rather than out at the far end: it is the
           way into the browser's own settings, and the address box is where the
           browser stops being the page and starts being itself. The dots are
           zero-length strokes with round caps, so they take the glyph styling —
           and its hover — like every other icon here. -->
      <!-- The star rides inside the address box, at its trailing end, the way
           every browser puts it: bookmarking is something you do to the address,
           so it belongs to that control rather than sitting beside it. The box
           carries the extra right padding that keeps text from running under it. -->
      <Panel Grid.Column="4" Margin="8,0,0,0">
        <TextBox Name="AddressBox"
                 Classes="address"
                 Padding="14,0,40,0"
                 Text="{Binding Shell.FocusedBrowser.AddressText}"
                 PlaceholderText="Search or enter address">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding Shell.FocusedBrowser.NavigateCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding Shell.FocusedBrowser.CancelAddressEditingCommand}" />
          </TextBox.KeyBindings>
        </TextBox>

        <!-- Filled once the open page is saved, hollow otherwise, and the anchor
             the add/edit form hangs from. -->
        <Button Name="BookmarkStar"
                Classes="icon inset"
                Classes.bookmarked="{Binding Shell.IsActivePageBookmarked}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                ToolTip.Tip="Bookmark this page (Ctrl+D)"
                Command="{Binding Shell.BookmarkActiveTabCommand}">
          <Path Classes="glyph"
                Data="M6.5,1 L8.2,4.9 L12.4,5.3 L9.2,8.1 L10.2,12.2 L6.5,10 L2.8,12.2 L3.8,8.1 L0.6,5.3 L4.8,4.9 Z" />
        </Button>
      </Panel>

      <!-- Downloads sits immediately left of the menu, where Chrome puts it:
           a file action next to the browser's own menu, not next to the page. -->
      <Panel Grid.Column="5" Width="28" Height="28" Margin="4,0,0,0">
        <Ellipse Width="26" Height="26"
                 Stroke="{DynamicResource BrandPrimaryBrush}"
                 StrokeThickness="1.5"
                 IsHitTestVisible="False"
                 IsVisible="{Binding Shell.Downloads.HasActiveDownloads, FallbackValue=False}" />
        <Button Name="DownloadsButton"
                Classes="icon"
                ToolTip.Tip="Downloads (Ctrl+J)"
                Command="{Binding Shell.ToggleDownloadsBubbleCommand}">
          <Path Classes="glyph"
                Data="M6.5,1.5 V8 M3.5,5.5 L6.5,8.5 L9.5,5.5 M2.2,11 H10.8" />
        </Button>
      </Panel>

      <!-- Settings takes the end of the bar, where a browser's own menu lives.
           The dots are zero-length strokes with round caps, so they take the
           glyph styling — and its hover — like every other icon here. -->
      <Button Grid.Column="6"
              Classes="icon"
              ToolTip.Tip="Settings">
        <Path Classes="glyph" StrokeThickness="2.2"
              Data="M6.5,2 L6.5,2 M6.5,6.5 L6.5,6.5 M6.5,11 L6.5,11" />
      </Button>

      <Popup IsOpen="{Binding Shell.IsBookmarkEditorOpen}"
             PlacementTarget="{Binding ElementName=BookmarkStar}"
             Placement="BottomEdgeAlignedRight"
             VerticalOffset="8"
             IsLightDismissEnabled="True"
             Closed="OnBookmarkEditorClosed">
        <views:BookmarkEditorView DataContext="{Binding Shell.BookmarkEditor}" />
      </Popup>

      <Popup IsOpen="{Binding Shell.IsDownloadsBubbleOpen}"
             PlacementTarget="{Binding ElementName=DownloadsButton}"
             Placement="BottomEdgeAlignedRight"
             VerticalOffset="8"
             IsLightDismissEnabled="True"
             ShouldUseOverlayLayer="False"
             Closed="OnDownloadsClosed">
        <views:DownloadsBubbleView DataContext="{Binding Shell}" />
      </Popup>

    </Grid>

    <!-- The loading bar used to sit here, directly under the navigation strip.
         It now lives below the bookmark bar in MainWindow so that it always
         marks the boundary between the browser's chrome and the page, rather
         than having a row of bookmarks appear beneath it. -->

  </Grid>

</UserControl>
