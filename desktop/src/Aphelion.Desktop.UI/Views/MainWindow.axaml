<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
        xmlns:views="using:Aphelion.Desktop.UI.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:controls="using:Aphelion.Desktop.UI.Controls"
        xmlns:dvo="using:Aphelion.Desktop.Domain.ValueObjects"
        x:Class="Aphelion.Desktop.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Shell.WindowTitle}"
        Icon="avares://Aphelion.Desktop.UI/Assets/aphelion_logo.ico"
        Width="1280" Height="800"
        MinWidth="860" MinHeight="560"
        Background="{DynamicResource SurfaceBaseBrush}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True">

  <!--
    WindowDecorations and ExtendClientAreaToDecorationsHint are both required.
    BorderOnly keeps the system frame — and with it resizing, snapping and the
    platform's own shadow and corners — while removing the system title bar.
    ExtendClientAreaToDecorationsHint activates WindowDecorationProperties.ElementRole.
  -->

  <Window.DataTemplates>
    <DataTemplate DataType="vm:BrowserViewModel">
      <views:BrowserView />
    </DataTemplate>
  </Window.DataTemplates>

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+T" Command="{Binding Shell.NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding Shell.CloseTabCommand}"
                CommandParameter="{Binding Shell.ActiveTab}" />
    <KeyBinding Gesture="Escape" Command="{Binding Shell.FocusedBrowser.CancelAddressEditingCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding Shell.BookmarkActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding Shell.ToggleBookmarkBarCommand}" />
  </Window.KeyBindings>

  <DockPanel>

    <Border DockPanel.Dock="Top"
            Classes="titlebar"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">

      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" DataContext="{Binding Shell}">

        <!-- Reserved for the macOS window controls, which stay system-drawn on the
             leading edge. Zero width on Windows and Linux. -->
        <Border Grid.Column="0"
                Width="{Binding $parent[Window].WindowDecorationMargin.Left}" />

        <Image Grid.Column="1"
               Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
               Width="20" Height="20"
               Margin="14,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <!-- Tab strip: tabs interleaved with group chips, with the new-tab button
             pinned immediately after the last tab. The User role goes on the
             interactive elements themselves, never their containers — marking a
             container makes its whole region undraggable. -->
        <Panel Grid.Column="2" Name="StripHost">

          <!-- The strip reports the width its tabs actually occupy, so the
               new-tab button lands against the last tab rather than being pushed
               to the far right. It still measures against the space available,
               which is what limits how many tabs fit. -->
          <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">

            <!-- Bound to StripHost by name, not $parent[Panel]: the nearest Panel
                 ancestor is the Grid right above, whose width comes from this
                 strip — a cycle that settles at zero and leaves no tabs at all. -->
            <ItemsControl Grid.Column="0" Name="TabStrip" ItemsSource="{Binding StripItems}"
                          MaxWidth="{Binding #StripHost.Bounds.Width,
                                             Converter={x:Static vm:DoubleConverters.LessNewTabButton}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:TabStripPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>

              <ItemsControl.DataTemplates>

                <DataTemplate DataType="vm:TabItemViewModel">
                  <Border Classes="tab"
                          Classes.active="{Binding IsActive}"
                          Classes.split="{Binding IsSplit}"
                          Classes.exiting="{Binding IsExiting}"
                          chrome:WindowDecorationProperties.ElementRole="User">

                    <!-- Menu items are always present and enabled or disabled
                         rather than hidden: hiding them leaves the separators
                         stranded, doubled or leading. -->
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Add to new group"
                                  Command="{Binding Owner.GroupActiveTabCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsGrouped}" />
                        <MenuItem Header="Remove from group"
                                  Command="{Binding Owner.UngroupTabCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding IsGrouped}" />
                        <Separator />
                        <MenuItem Header="Open in split view"
                                  Command="{Binding Owner.SplitWithTabCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding CanSplitWithActive}" />
                        <MenuItem Header="Close left side"
                                  Command="{Binding Owner.CloseLeftSideCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding IsSplit}" />
                        <MenuItem Header="Close right side"
                                  Command="{Binding Owner.CloseRightSideCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding IsSplit}" />
                        <MenuItem Header="Close split view"
                                  Command="{Binding Owner.CloseSplitCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding IsSplit}" />
                        <Separator />
                        <MenuItem Header="Move to new window"
                                  Command="{Binding Owner.MoveTabToNewWindowCommand}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Close tab"
                                  Command="{Binding Owner.CloseTabCommand}"
                                  CommandParameter="{Binding}" />
                      </ContextMenu>
                    </Border.ContextMenu>

                    <!-- A split pair reads as "favicon name | favicon name". The
                         halves live in a uniform grid inside one star column, so
                         each gets exactly half the space when split and the first
                         takes all of it when not. -->
                    <Grid ColumnDefinitions="Auto,*,Auto">

                      <Border Grid.Column="0"
                              Classes="group-marker"
                              IsVisible="{Binding IsGrouped}"
                              Background="{Binding GroupBrush}" />

                      <!-- The halves. A custom panel, because a Grid cannot do
                           this: Auto columns let a long title measure at full
                           length and spill over its neighbour, while star columns
                           keep their share even when collapsed and leave a gap. -->
                      <controls:SplitTabPanel Grid.Column="1">

                        <!-- Grid, not StackPanel: a horizontal StackPanel offers
                             its children unlimited width, so the title measures
                             at full length and paints over the other half. -->
                        <Grid Classes="half" ColumnDefinitions="Auto,*">
                          <Image Grid.Column="0"
                                 Classes="favicon"
                                 Source="{Binding Favicon}"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNotNull}}" />

                          <!-- Placeholder until the site's icon arrives, or when it
                               has none: a blank gap would make the strip jump. -->
                          <Path Grid.Column="0"
                                Classes="favicon-fallback"
                                Width="13" Height="13"
                                Data="M1,6.5 A5.5,5.5 0 1 0 12,6.5 A5.5,5.5 0 1 0 1,6.5 M1,6.5 H12 M6.5,1 A8,8 0 0 1 6.5,12 A8,8 0 0 1 6.5,1"
                                IsVisible="{Binding Favicon, Converter={x:Static ObjectConverters.IsNull}}" />

                          <!-- Squeezed to a single character as tabs narrow, but
                               never away: favicon, one letter and the close button
                               are what the narrowest tab keeps. -->
                          <controls:MarqueeTextBlock Grid.Column="1"
                                                     Classes="tab-title"
                                                     MinWidth="10"
                                                     Text="{Binding Title}"
                                                     IsScrollEnabled="{Binding IsActive}" />
                        </Grid>

                        <Border Classes="split-divider"
                                IsVisible="{Binding IsSplit}" />

                        <Grid Classes="half"
                              ColumnDefinitions="Auto,*"
                              IsVisible="{Binding IsSplit}">
                          <Image Grid.Column="0"
                                 Classes="favicon"
                                 Source="{Binding PartnerFavicon}"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 IsVisible="{Binding PartnerFavicon, Converter={x:Static ObjectConverters.IsNotNull}}" />

                          <Path Grid.Column="0"
                                Classes="favicon-fallback"
                                Width="13" Height="13"
                                Data="M1,6.5 A5.5,5.5 0 1 0 12,6.5 A5.5,5.5 0 1 0 1,6.5 M1,6.5 H12 M6.5,1 A8,8 0 0 1 6.5,12 A8,8 0 0 1 6.5,1"
                                IsVisible="{Binding ShowsPartnerFallback}" />

                          <!-- Scrolls on its own side, exactly as the primary
                               title does, so a long partner name is readable. -->
                          <controls:MarqueeTextBlock Grid.Column="1"
                                                     Classes="tab-title-partner"
                                                     MinWidth="10"
                                                     Text="{Binding PartnerTitle}"
                                                     IsScrollEnabled="{Binding IsActive}" />
                        </Grid>

                      </controls:SplitTabPanel>

                      <Button Grid.Column="2"
                              Classes="icon small"
                              ToolTip.Tip="Close tab"
                              Margin="6,0,0,0"
                              Command="{Binding Owner.CloseTabCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="glyph" Data="M0,0 L8,8 M8,0 L0,8" />
                      </Button>

                    </Grid>
                  </Border>
                </DataTemplate>

                <!-- Group chip: click collapses, menu renames/recolours/ungroups/closes -->
                <DataTemplate DataType="vm:GroupHeaderViewModel">
                  <Button Classes="chip"
                          Command="{Binding ToggleCollapsedCommand}"
                          ToolTip.Tip="{Binding Name}"
                          chrome:WindowDecorationProperties.ElementRole="User">

                    <Border Classes="chip-pill" Background="{Binding Brush}">
                      <TextBlock Classes="chip-text" Text="{Binding Name}" />
                    </Border>

                    <Button.ContextMenu>
                      <ContextMenu>
                        <!-- Rename sits in a submenu rather than as a bare editor
                             in the menu body: a headerless item renders as an
                             empty row in the list. -->
                        <MenuItem Header="Rename">
                          <MenuItem StaysOpenOnClick="True">
                            <MenuItem.Header>
                              <TextBox Width="170"
                                       Classes="menu-editor"
                                       Text="{Binding Name, Mode=TwoWay}" />
                            </MenuItem.Header>
                          </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Color">
                          <MenuItem Header="Violet" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Violet}" />
                          <MenuItem Header="Cyan" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Cyan}" />
                          <MenuItem Header="Emerald" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Emerald}" />
                          <MenuItem Header="Amber" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Amber}" />
                          <MenuItem Header="Rose" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Rose}" />
                          <MenuItem Header="Slate" Command="{Binding RecolorCommand}" CommandParameter="{x:Static dvo:GroupColor.Slate}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Ungroup" Command="{Binding UngroupCommand}" />
                        <MenuItem Header="Close group" Command="{Binding CloseGroupCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>

                  </Button>
                </DataTemplate>

              </ItemsControl.DataTemplates>
            </ItemsControl>

            <!-- Pinned immediately after the last tab, so it travels with the
                 strip instead of sitting at a fixed spot on the right. -->
            <Button Grid.Column="1"
                    Classes="icon"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="New tab"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Command="{Binding NewTabCommand}">
              <Path Classes="glyph" Data="M6,0 V12 M0,6 H12" />
            </Button>

          </Grid>

          <!-- Insertion preview for a tab dragged in from another window -->
          <Border Name="DropIndicator"
                  Width="2" Height="26"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource BrandPrimaryBrush}"
                  IsHitTestVisible="False"
                  IsVisible="False" />

        </Panel>

        <!-- Overflow: opens the list of tabs the strip could not fit. Sits where
             the new-tab button used to, and only appears when there is overflow. -->
        <Button Grid.Column="3"
                Name="OverflowToggle"
                Classes="icon"
                Margin="4,0"
                VerticalAlignment="Center"
                ToolTip.Tip="Other tabs"
                chrome:WindowDecorationProperties.ElementRole="User"
                IsVisible="{Binding HasOverflow}"
                Command="{Binding ToggleOverflowCommand}">
          <Path Classes="glyph" Data="M1,3 H11 M1,6.5 H11 M1,10 H11" />
        </Button>

        <!-- Caption buttons. Hidden on macOS, where the system draws its own on
             the left and WindowDecorationMargin.Left is non-zero. -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding !$parent[Window].WindowDecorationMargin.Left}">

          <Button Classes="caption" ToolTip.Tip="Minimize" Click="OnMinimizeRequested"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <Path Classes="caption-glyph" Data="M0,5 H10" />
          </Button>

          <Button Classes="caption" ToolTip.Tip="Maximize" Click="OnMaximizeRequested"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding $parent[Window].WindowState,
                                      Converter={x:Static vm:BoolConverters.IsResizableAtEdges}}">
            <Path Classes="caption-glyph" Data="M0,0 H10 V10 H0 Z" />
          </Button>

          <Button Classes="caption" ToolTip.Tip="Restore" Click="OnMaximizeRequested"
                  chrome:WindowDecorationProperties.ElementRole="User"
                  IsVisible="{Binding $parent[Window].WindowState,
                                      Converter={x:Static vm:BoolConverters.IsMaximized}}">
            <Path Classes="caption-glyph" Data="M0,2.5 H7.5 V10 H0 Z M2.5,2.5 V0 H10 V7.5 H7.5" />
          </Button>

          <Button Classes="caption close" ToolTip.Tip="Close" Click="OnCloseRequested"
                  chrome:WindowDecorationProperties.ElementRole="User">
            <Path Classes="caption-glyph" Data="M0,0 L10,10 M10,0 L0,10" />
          </Button>

        </StackPanel>

      </Grid>
    </Border>

    <!-- Content: the active tab's page, and beside it the split partner's when
         split view is on. The third column's width is driven from code-behind,
         since ColumnDefinitions sit outside the visual tree and cannot bind.
         Other Tabs reserves a drawer beside it because a native WebView cannot
         be composited underneath an Avalonia overlay. -->
    <!-- One toolbar for the window, above both panes -->
    <views:BrowserToolbarView Name="BrowserToolbar" DockPanel.Dock="Top" />

    <!-- Sits between the toolbar and the page, as in Chrome, and stays visible.
         Hiding it will become a setting once there is a settings store to keep
         the choice in; until then a toggle that forgets itself every launch is
         worse than no toggle. -->
    <ContentControl DockPanel.Dock="Top"
                    Content="{Binding Shell.Bookmarks}"
                    IsVisible="{Binding Shell.IsBookmarkBarVisible}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:BookmarksViewModel">
          <views:BookmarkBarView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- Below the bookmark bar rather than tucked under the navigation strip, so
         it reads as the line where the browser's own chrome ends and the page
         begins no matter what sits above it. -->
    <ProgressBar DockPanel.Dock="Top"
                 Classes="navigation-progress"
                 Minimum="0"
                 Maximum="100"
                 Value="{Binding Shell.FocusedBrowser.LoadingProgress}"
                 IsVisible="{Binding Shell.FocusedBrowser.IsLoadingProgressVisible}" />

    <Grid Name="ContentHost" ColumnDefinitions="*,0">

      <Grid Grid.Column="0" Name="BrowserHost">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="0" />
      </Grid.ColumnDefinitions>

      <!--
        The panes are empty frames. Every open tab's browser is held as a direct
        child of this grid for as long as the tab lives, put in one column or the
        other and shown or hidden — see UpdateBrowserPool in the code-behind. A
        web view is a native window and is destroyed the moment it leaves the
        visual tree, so hosting only the active tab reloaded every site on every
        switch back to it.

        Clicking a pane gives it the focus, and the toolbar follows it — the
        inactive pane carries a lighter border, as in Chrome.
      -->
      <Border Grid.Column="0"
              Name="LeftPane"
              Classes="pane"
              Classes.focused="{Binding !Shell.IsRightPaneFocused}"
              Classes.split="{Binding Shell.IsSplit}" />

      <!-- Width and background come from the style; setting them here would win
           over it, and the hover colour would never appear. -->
      <GridSplitter Grid.Column="1"
                    Classes="pane-splitter"
                    IsVisible="{Binding Shell.IsSplit}" />

      <!-- The second pane: the partner's page once chosen, and before that the
           picker asking what to put there — as Chrome does, rather than a modal
           floating over the whole window. -->
      <Border Grid.Column="2"
              Name="RightPane"
              Classes="pane"
              Classes.focused="{Binding Shell.IsRightPaneFocused}"
              Classes.split="{Binding Shell.IsSplit}"
              IsVisible="{Binding Shell.IsSplit}">
        <Panel>

          <Panel Background="{DynamicResource SurfaceBaseBrush}"
                 IsVisible="{Binding Shell.IsSplitPickerOpen}">
            <Button Classes="icon"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    ToolTip.Tip="Cancel"
                    Command="{Binding Shell.CloseSplitPickerCommand}">
              <Path Classes="glyph" Data="M0,0 L10,10 M10,0 L0,10" />
            </Button>

            <views:TabListView DataContext="{Binding Shell.SplitPicker}"
                               Width="320"
                               MaxHeight="520"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
          </Panel>

        </Panel>
      </Border>

      <!--
        A hosted WebView is a native surface and paints above ordinary Avalonia
        children. This one-pixel target gives the zoom feedback a stable,
        layout-owned position while Popup creates a separate native top level
        above that surface. Its column follows the focused split pane in
        code-behind; resize, fullscreen and splitter changes need no screen
        coordinate calculations.

        The outer margin belongs to the popup content so its shadow is never
        clipped. Together with the target offset it leaves the visible card 14px
        from the page's top and right edges.
      -->
      <Border Grid.Column="0"
              Name="ZoomFeedbackAnchor"
              Width="1" Height="1"
              Margin="0,14,14,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top">
        <Popup PlacementTarget="{Binding #ZoomFeedbackAnchor}"
               Placement="LeftEdgeAlignedTop"
               ShouldUseOverlayLayer="False"
               TakesFocusFromNativeControl="False"
               IsLightDismissEnabled="False"
               WindowManagerAddShadowHint="False"
               IsOpen="{Binding Shell.ZoomFeedback.IsVisible}">
          <Border Classes="zoom-toast"
                  Opacity="1"
                  IsHitTestVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="icon small" ToolTip.Tip="Zoom out"
                      Command="{Binding Shell.FocusedBrowser.ZoomOutCommand}">
                <Path Classes="glyph" Data="M2,6.5 H11" />
              </Button>
              <Button Classes="zoom-toast-label" ToolTip.Tip="Reset zoom"
                      Command="{Binding Shell.FocusedBrowser.ResetZoomCommand}">
                <TextBlock Text="{Binding Shell.ZoomFeedback.Label}" />
              </Button>
              <Button Classes="icon small" ToolTip.Tip="Zoom in"
                      Command="{Binding Shell.FocusedBrowser.ZoomInCommand}">
                <Path Classes="glyph" Data="M6.5,2 V11 M2,6.5 H11" />
              </Button>
            </StackPanel>
          </Border>
        </Popup>
      </Border>
      </Grid>

      <!-- Native web surfaces cannot sit underneath Avalonia overlays. Reserving
           a real drawer column keeps the active page live and visible instead of
           replacing it with an empty backdrop while Other Tabs is open. -->
      <!-- Width lives on the column, not on this Border, and collapses to zero
           when the drawer is closed. A fixed Width here kept the Auto column
           344px wide even while IsVisible was false, leaving a dead black strip
           beside the page whenever Other Tabs was shut. -->
      <Border Grid.Column="1"
              Name="OverflowDrawer"
              Classes="drawer-host"
              IsVisible="{Binding Shell.IsOverflowOpen}">
        <views:TabListView DataContext="{Binding Shell.Overflow}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
      </Border>

    </Grid>

  </DockPanel>

</Window>
