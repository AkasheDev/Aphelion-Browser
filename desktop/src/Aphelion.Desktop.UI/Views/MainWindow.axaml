<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
        xmlns:views="using:Aphelion.Desktop.UI.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:input="using:Avalonia.Input"
        x:Class="Aphelion.Desktop.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Shell.WindowTitle}"
        Icon="avares://Aphelion.Desktop.UI/Assets/aphelion_logo.ico"
        Width="1280"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AphelionSurfaceBrush}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True">

  <!-- The window frame, its corners, shadow, resize borders and snap behaviour all
       come from the operating system. Drawing our own looked wrong and broke
       resizing, and could not behave correctly on Windows, macOS and Linux at once. -->
  <Panel Background="{DynamicResource AphelionSurfaceBrush}">

    <Grid RowDefinitions="Auto,*" DataContext="{Binding Shell}" Margin="{Binding $parent[Window].OffScreenMargin}">

      <!-- Title bar. The TitleBar role hands dragging, double-click maximise and
           Windows snap back to the system, which a hand-rolled drag cannot provide. -->
      <Grid Grid.Row="0"
            Name="TitleBar"
            Height="40"
            ColumnDefinitions="Auto,Auto,*,Auto,Auto"
            Background="{DynamicResource AphelionChromeBrush}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">

        <!-- Room for macOS traffic lights, which sit on the left. Zero elsewhere. -->
        <Panel Grid.Column="0"
               Width="{Binding $parent[Window].WindowDecorationMargin.Left}" />

        <!-- Logo occupies the side rail's width so the first tab lines up with the
             content area rather than floating over the rail. -->
        <Image Grid.Column="1"
               Source="avares://Aphelion.Desktop.UI/Assets/aphelion_logo_colored.png"
               Width="20"
               Height="20"
               Margin="14,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapInterpolationMode="HighQuality" />

        <!-- Tab strip -->
        <ScrollViewer Grid.Column="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:TabItemViewModel">
                <!-- Chrome-style tab: the active one merges into the content area
                     below, with the skirt pieces curving away on both sides. -->
                <Panel Classes.active="{Binding IsActive}"
                       Classes="tabhost"
                       MinWidth="160"
                       MaxWidth="250"
                       Height="40">

                  <Grid ColumnDefinitions="8,*,8" VerticalAlignment="Bottom" Height="34">

                    <!-- Left skirt: fills the corner, then the inner curve cuts it -->
                    <Panel Grid.Column="0" VerticalAlignment="Bottom" Height="10">
                      <Border Classes="tabskirt" />
                      <Border Classes="tabnotch" CornerRadius="0,0,8,0" />
                    </Panel>

                    <Border Grid.Column="1" Classes="tabbody" CornerRadius="8,8,0,0" />

                    <Panel Grid.Column="2" VerticalAlignment="Bottom" Height="10">
                      <Border Classes="tabskirt" />
                      <Border Classes="tabnotch" CornerRadius="0,0,0,8" />
                    </Panel>

                  </Grid>

                  <!-- Content sits above the shape -->
                  <Grid ColumnDefinitions="Auto,*,Auto"
                        Margin="14,0,8,0"
                        VerticalAlignment="Center">

                    <Border Grid.Column="0"
                            Width="3"
                            Height="15"
                            CornerRadius="2"
                            Margin="0,0,8,0"
                            IsVisible="{Binding IsGrouped}"
                            Background="{Binding GroupBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2"
                            Classes="tabclose"
                            Content="&#x2715;"
                            FontSize="9"
                            Width="20"
                            Height="20"
                            Padding="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:ShellViewModel)DataContext).CloseTabCommand}"
                            CommandParameter="{Binding}" />

                  </Grid>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

          <Button Classes="chrome"
                  Content="+"
                  FontSize="16"
                  ToolTip.Tip="New tab"
                  Command="{Binding NewTabCommand}" />

          <Button Classes="chrome"
                  Content="&#x25A3;"
                  ToolTip.Tip="Group or ungroup the active tab"
                  Command="{Binding GroupActiveTabCommand}" />

        </StackPanel>

        <!-- Caption buttons. The element roles hand their behaviour to the window
             manager, so these act like real caption buttons rather than ordinary
             buttons that happen to call Close(). Hidden on macOS, where the system
             draws traffic lights on the left instead. -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding !$parent[Window].WindowDecorationMargin.Left}">

          <Button Classes="caption" ToolTip.Tip="Minimize"
                  chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
            <Rectangle Width="10" Height="1" Fill="{Binding $parent[Button].Foreground}" />
          </Button>

          <Button Classes="caption" ToolTip.Tip="Maximize"
                  chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
            <Rectangle Width="9" Height="9" StrokeThickness="1"
                       Stroke="{Binding $parent[Button].Foreground}" />
          </Button>

          <Button Classes="caption close" ToolTip.Tip="Close"
                  chrome:WindowDecorationProperties.ElementRole="CloseButton">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                  StrokeThickness="1"
                  Stroke="{Binding $parent[Button].Foreground}" />
          </Button>

        </StackPanel>

      </Grid>

      <!-- Body: side rail, optional panel, browser -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">

        <views:SideRailView Grid.Column="0" DataContext="{Binding SidePanel}" />

        <views:SidePanelView Grid.Column="1"
                             DataContext="{Binding SidePanel}"
                             IsVisible="{Binding IsExpanded}" />

        <ContentControl Grid.Column="2"
                        Content="{Binding ActiveBrowser}">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:BrowserViewModel">
              <views:BrowserView />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

      </Grid>

    </Grid>

    <!-- Resize handles. Avalonia does not add them for an extended client area, so
         the window is unresizable without these. Each is a transparent strip on the
         window edge whose element role tells the window manager which direction it
         resizes; they sit above the content so they still work over the web view.
         Hidden when maximised, where the edges belong to the screen. -->
    <Grid Name="ResizeHandles"
          IsHitTestVisible="True"
          IsVisible="{Binding $parent[Window].WindowState,
                              Converter={x:Static vm:BoolConverters.IsResizableAtEdges}}"
          RowDefinitions="6,*,6"
          ColumnDefinitions="6,*,6">

      <Panel Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
             chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
      <Panel Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
             chrome:WindowDecorationProperties.ElementRole="ResizeN" />
      <Panel Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
             chrome:WindowDecorationProperties.ElementRole="ResizeNE" />

      <Panel Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="SizeWestEast"
             chrome:WindowDecorationProperties.ElementRole="ResizeW" />
      <Panel Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="SizeWestEast"
             chrome:WindowDecorationProperties.ElementRole="ResizeE" />

      <Panel Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
             chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
      <Panel Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
             chrome:WindowDecorationProperties.ElementRole="ResizeS" />
      <Panel Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
             chrome:WindowDecorationProperties.ElementRole="ResizeSE" />

    </Grid>

  </Panel>

</Window>
