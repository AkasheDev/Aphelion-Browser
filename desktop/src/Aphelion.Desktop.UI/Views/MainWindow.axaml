<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
        xmlns:views="using:Aphelion.Desktop.UI.Views"
        x:Class="Aphelion.Desktop.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280"
        Height="800"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <views:BrowserView DataContext="{Binding Browser}" />

</Window>
