<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aphelion.Desktop.UI.ViewModels"
             x:Class="Aphelion.Desktop.UI.Views.SideRailView"
             x:DataType="vm:SidePanelViewModel">

  <Border Width="48" Background="{DynamicResource AphelionChromeBrush}">
    <StackPanel Margin="0,8" Spacing="4">

      <Button Classes="rail"
              Content="&#x25A4;"
              ToolTip.Tip="Tabs"
              Command="{Binding ToggleCommand}"
              CommandParameter="{x:Static vm:SidePanelTool.Tabs}" />

      <Button Classes="rail"
              Content="&#x21BA;"
              ToolTip.Tip="History"
              Command="{Binding ToggleCommand}"
              CommandParameter="{x:Static vm:SidePanelTool.History}" />

      <Button Classes="rail"
              Content="&#x2606;"
              ToolTip.Tip="Bookmarks"
              Command="{Binding ToggleCommand}"
              CommandParameter="{x:Static vm:SidePanelTool.Bookmarks}" />

      <Button Classes="rail"
              Content="&#x2193;"
              ToolTip.Tip="Downloads"
              Command="{Binding ToggleCommand}"
              CommandParameter="{x:Static vm:SidePanelTool.Downloads}" />

    </StackPanel>
  </Border>

</UserControl>
